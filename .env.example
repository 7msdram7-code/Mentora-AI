# MistakeMirror Environment Configuration

# Database Connection (defaults to local SQLite)
DATABASE_URL=sqlite:///./mistakemirror.db

# LLM Configuration
# Set USE_MOCK_LLM=true to run completely offline without API keys (Default for hackathons / zero-cost setup)
USE_MOCK_LLM=true

# Provider Selection: "groq" (Recommended open-source API), "ollama" (Local offline open-source), "gemini", or "anthropic"
LLM_PROVIDER=groq

# 1. Open-Source AI via Groq API (High-speed Llama 3.3 70B & Llama 3.1 8B - free tier available at console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 2. Local Open-Source AI via Ollama (100% offline & free, e.g. ollama run llama3.2)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# 3. Optional Proprietary Model APIs
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
